# Copy to .env and fill in. .env is gitignored; this file is not, so keep it keyless.
# NOTE: docker --env-file has no inline comments. Keep comments on their own line.
#
# Per-run override without editing .env -- run.sh forwards these from your shell:
#   PROVIDER=fireworks MODEL=kimi-k3 ./run.sh "..."
#   PROVIDER=fireworks MODEL=glm-5.3-flash ./evals.sh --dataset humaneval --shards 24

# PROVIDER=openai | fireworks | together | baseten | qwen
PROVIDER=fireworks

# MODEL takes a catalog alias, which is portable across the three hosted platforms:
#   deepseek-v4-pro  deepseek-v4-flash  glm-5.3  glm-5.3-flash
#   kimi-k3  qwen-3.7-plus  qwen-3.8-max      (the Qwen tiers: not on baseten)
# A raw platform id also works, for a model newer than agent_loop/providers.py.
# Leave it unset and each provider uses its own default (glm-5.3-flash on the hosted
# three). An alias a provider does not serve is a hard error, not a silent substitution,
# so MODEL belongs on the command line rather than in this file.
# MODEL=glm-5.3-flash

# Only the model's floor is sent by default (see the catalog's `reasoning` tuples).
# Set this to spend tokens thinking: low | medium | high | max, or an integer budget.
# REASONING_EFFORT=high

# fireworks -- the default. See docs/PROVIDERS.md for why.
FIREWORKS_API_KEY=

# together / baseten -- same wire, same aliases; kept so a platform A/B is a prefix.
TOGETHER_API_KEY=
BASETEN_API_KEY=

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# qwen (self-hosted vLLM)
QWEN_BASE_URL=http://localhost:9000/v1
QWEN_MODEL=qwen3.5-9b
QWEN_API_KEY=EMPTY
QWEN_THINKING=0
