# Which backend the agent loop talks to: openai (default) or qwen
PROVIDER=openai

# --- openai ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.4-nano

# --- qwen: self-hosted Qwen3.5-9B behind vLLM (OpenAI-compatible) ---
# QWEN_BASE_URL=http://localhost:9000/v1     # on the GPU box; from the tailnet use https://api.lemontree.media/v1
# QWEN_MODEL=qwen3.5-9b
# QWEN_API_KEY=EMPTY
# QWEN_THINKING=0                            # 1 = let the model reason before answering
