# Copy to .env and fill in the keys. .env is gitignored; this file is not, so keep it
# keyless.
# NOTE: docker --env-file has no inline comments. Keep comments on their own line.
#
# Anything set in your shell beats this file, so a one-off is a prefix and never an edit:
#   PROVIDER=openai MODEL= ./test.sh agent
#   PROVIDER=fireworks MODEL=kimi-k3 ./evals.sh --dataset humaneval --shards 24

# PROVIDER: fireworks | together | openai | qwen
#   fireworks  the default. All six hosted models, deepest prompt-cache discounts, and
#              published rate-limit ceilings. Falls over to together (see FALLBACK).
#   together   the same six models, same aliases. Cheaper on deepseek-v4-flash only.
#   openai     the Responses API and the gpt-5* family; ignores MODEL, uses OPENAI_MODEL.
#   qwen       the self-hosted vLLM box at QWEN_BASE_URL; ignores MODEL, uses QWEN_MODEL.
PROVIDER=fireworks

# MODEL: a portable alias, resolved to whatever id the active provider calls it.
# Serving prices are per 1M tokens (input / cached / output) on fireworks.
#   glm-5.3-flash      0.15 / 0.03 / 0.50    the default: cheapest that still uses tools
#                                            well. Reasons unconditionally, at "low".
#   deepseek-v4-flash  0.22 / 0.007 / 0.66   cheapest cached input of the lot
#   qwen-3.7-plus      0.40 / 0.08  / 1.60   agent-tuned, 262k context, reasoning optional
#   deepseek-v4-pro    1.32 / 0.044 / 3.96   the flagship coder, pinned to the 0813 build
#   glm-5.3            1.40 / 0.26  / 4.40   long-horizon agentic work. Always reasons.
#   qwen-3.8-max       2.00 / 0.25  / 6.00   2.4T MoE, for multi-day runs
#   kimi-k3            3.00 / 0.30  / 15.00  the most capable and 20x the default's price.
#                                            Always reasons, at "max" unless told otherwise.
#
# A raw platform id also works, for a model newer than agent_loop/providers.py.
# An alias the active provider does not serve is a hard error, never a substitution -
# so if you switch PROVIDER to openai or qwen, clear this with MODEL= on the command line.
MODEL=glm-5.3-flash

# REASONING_EFFORT: none | low | medium | high | max, or an integer token budget.
# Unset, each model gets the cheapest effort it will accept - "none" where reasoning can
# be turned off, "low" where it cannot. Raise it to trade tokens for a harder problem.
# REASONING_EFFORT=high

# MAX_OUTPUT_TOKENS: overrides the per-model cap (8192, or 32768 where reasoning is
# always on and has to fit before the tool call).
# MAX_OUTPUT_TOKENS=16384

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# qwen (self-hosted)
QWEN_BASE_URL=http://localhost:9000/v1
QWEN_MODEL=qwen3.5-9b
QWEN_API_KEY=
QWEN_THINKING=0

# hosted open-weights platforms (see docs/PROVIDERS.md for how these two were picked)
#
# FALLBACK: together | none.  Unset, fireworks pairs with together automatically when
# TOGETHER_API_KEY is set: a request refused with a 5xx, a timeout, a dead key, a 404 or
# a 429 is re-sent to the other platform as the same model, and the run's JSON reports
# fallback_calls so a degraded run is never a silent one. A 400 is not retried anywhere.
#   FALLBACK=none      one platform, no cover. Use it for a benchmark number that has to
#                      come from a single serving stack.
#   FALLBACK=together  demand it - an error if TOGETHER_API_KEY is missing, rather than
#                      the warning the default gets.
# FALLBACK=none
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
